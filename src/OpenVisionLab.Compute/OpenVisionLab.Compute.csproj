<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageDescription>Optional acceleration discovery, session ownership and CPU fallback evidence for OpenVisionLab.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenVisionLab.Inspection.Smoke" />
    <InternalsVisibleTo Include="OpenVisionLab.Vision2D" />
    <InternalsVisibleTo Include="OpenVisionLab.Vision3D" />
  </ItemGroup>
</Project>
