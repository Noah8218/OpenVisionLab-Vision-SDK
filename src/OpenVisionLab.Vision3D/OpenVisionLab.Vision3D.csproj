<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageDescription>UI-independent height-map, full-XYZ geometry, matching, and 3D inspection contracts and algorithms for OpenVisionLab.</PackageDescription>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\docs\three-d-inspection.md" Pack="true" PackagePath="docs" Link="docs\three-d-inspection.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenVisionLab.Compute\OpenVisionLab.Compute.csproj" />
  </ItemGroup>

</Project>
